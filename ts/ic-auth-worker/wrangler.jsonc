{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ic-auth-worker",
	"main": "src/index.ts",
	"compatibility_date": "2025-11-05",
	// Service-binding deployment by default. Enable a public route explicitly.
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": false },
	"migrations": [{ "new_sqlite_classes": ["AuthContainer"], "tag": "v1" }],
	"containers": [
		{
			"name": "ic-auth-container",
			"class_name": "AuthContainer",
			"instance_type": "lite",
			// Build the verifier from this checkout; no account-specific registry.
			"image": "../../rs/ic_auth_verify_server/Dockerfile",
			"image_build_context": "../..",
			// Nine regional names plus a default instance.
			"max_instances": 10
		}
	],
	"durable_objects": {
		"bindings": [{ "class_name": "AuthContainer", "name": "AUTH_CONTAINER" }]
	}
}
