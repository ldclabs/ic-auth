{
  "name": "@ldclabs/ic-auth",
  "version": "0.5.2",
  "type": "module",
  "description": "TypeScript client SDK for IC-Auth identities, deterministic CBOR signing, and compact envelope types.",
  "license": "MIT",
  "homepage": "https://github.com/ldclabs/ic-auth/tree/main/ts/ic-auth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ldclabs/ic-auth.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "typings": "./dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "format": "prettier --write src *.json README.md",
    "coverage": "vitest run --coverage",
    "test": "vitest run",
    "ncu": "npx npm-check-updates -u",
    "format:check": "prettier --check src *.json README.md",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "peerDependencies": {
    "@icp-sdk/core": ">=5.0.0",
    "@noble/hashes": ">=1.8.0",
    "cborg": ">=4.5.0"
  },
  "devDependencies": {
    "@icp-sdk/core": "^5.2.1",
    "@noble/hashes": "^2.4.0",
    "@types/node": "25.6.0",
    "@vitest/coverage-v8": "4.0.18",
    "cborg": "^5.1.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.2",
    "vitest": "4.0.18"
  }
}
